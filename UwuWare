local promptCallback = nil

local function showPrompt(title, placeholder, callback)
    promptTitle.Text = title or "Enter name:"
    promptInput.Text = ""
    promptInput.PlaceholderText = placeholder or "Player name..."
    promptCallback = callback
    promptOverlay.Visible = true
    promptFrame.Visible = true
    if isMobile then
        promptInput:CaptureFocus()
    end
end

local function hidePrompt()
    promptOverlay.Visible = false
    promptFrame.Visible = false
    promptCallback = nil
    promptInput:ReleaseFocus()
end

promptConfirm.MouseButton1Click:Connect(function()
    local text = promptInput.Text
    local cb = promptCallback
    hidePrompt()
    if cb and text and text ~= "" then
        local success, err = pcall(cb, text)
        if not success then warn("[Monarch Hub] Prompt error:", err) end
    end
end)

