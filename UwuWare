-- ========== LASER ==========
local laserbool = false
local laserOriginals = {}
local laserValues = { AutoFire = true, FireRate = 0.035, SpreadRadius = 0 }
local laserBackpackConn = nil
local laserCharConn = nil
local laserRespawnConn = nil

local function laserRestoreAll()
    for tool, originals in pairs(laserOriginals) do
        if typeof(tool) == "Instance" and tool.Parent then
            pcall(function()
                for attr, value in pairs(originals) do tool:SetAttribute(attr, value) end
            end)
        end
    end
    table.clear(laserOriginals)
end

local function applyLaserToTool(tool)
    if not laserbool or not tool or not tool:IsA("Tool") then return end
    if tool:GetAttribute("ToolType") ~= "Gun" and tool:GetAttribute("FireRate") == nil then return end
    if not laserOriginals[tool] then
        local orig = {}
        for attr in pairs(laserValues) do orig[attr] = tool:GetAttribute(attr) end
        laserOriginals[tool] = orig
    end
    for attr, value in pairs(laserValues) do
        if tool:GetAttribute(attr) ~= value then tool:SetAttribute(attr, value) end
    end
end

local function applyLaserToAll()
    if not laserbool then return end
    local bp = localp:FindFirstChildOfClass("Backpack")
    if bp then for _, c in ipairs(bp:GetChildren()) do applyLaserToTool(c) end end
    local char = localp.Character
    if char then for _, c in ipairs(char:GetChildren()) do applyLaserToTool(c) end end
end

local function bindLaserHooks()
    if laserBackpackConn then laserBackpackConn:Disconnect() laserBackpackConn = nil end
    if laserCharConn then laserCharConn:Disconnect() laserCharConn = nil end
    local bp = localp:FindFirstChildOfClass("Backpack")
    if bp then laserBackpackConn = bp.ChildAdded:Connect(applyLaserToTool) end
    local char = localp.Character
    if char then laserCharConn = char.ChildAdded:Connect(applyLaserToTool) end
end

local function laser(state)
    if state == nil then laserbool = not laserbool else laserbool = state and true or false end
    if laserbool then
        bindLaserHooks()
        applyLaserToAll()
        if not laserRespawnConn then
            laserRespawnConn = localp.CharacterAdded:Connect(function()
                if not laserbool then return end
                task.wait(0.35)
                table.clear(laserOriginals)
                bindLaserHooks()
                applyLaserToAll()
            end)
        end
        notify("Monarch Hub", "Laser Enabled", 3)
    else
        laserRestoreAll()
        if laserBackpackConn then laserBackpackConn:Disconnect() laserBackpackConn = nil end
        if laserCharConn then laserCharConn:Disconnect() laserCharConn = nil end
        if laserRespawnConn then laserRespawnConn:Disconnect() laserRespawnConn = nil end
        notify("Monarch Hub", "Laser Disabled", 3)
    end
end

local function unlaser() laser(false) end

