-- ========== AUTO GUNS ==========
local autoGunsEnabled = false
local autoGunsSelected = {["AK-47"] = true, ["Remington 870"] = true, ["MP5"] = false, ["M4A1"] = false, ["FAL"] = false, ["M700"] = false}

local function hasGun(name)
    local ch = localp.Character
    return (localp:FindFirstChild("Backpack") and localp.Backpack:FindFirstChild(name))
        or (ch and ch:FindFirstChild(name))
end

local function helperAnim()
    local hum = localp.Character and localp.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://180426354"
    anim.Parent = hum
    local track = hum:LoadAnimation(anim)
    track:Play()
end

local function giveGun(gunName)
    local giver = Workspace:FindFirstChild("Prison_ITEMS") and Workspace.Prison_ITEMS:FindFirstChild("giver")
    if not giver then return end
    local event = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("InteractWithItem")
    if not event then return end
    local hp = localp.Character and localp.Character:FindFirstChild("HumanoidRootPart")
    if not hp then return end
    local og = hp.CFrame
    local targetItem = nil
    for _, child in ipairs(giver:GetChildren()) do
        if child.Name:find(gunName) or (child:FindFirstChild("Meshes") and child.Meshes:FindFirstChild(gunName)) then
            targetItem = child
            break
        end
    end
    if not targetItem then return end
    hp.CFrame = CFrame.new(-929, 97, 2056)
    helperAnim()
    task.wait(0.1)
    hp.CFrame = targetItem:FindFirstChild("Meshes") and targetItem.Meshes:GetChildren()[1] and targetItem.Meshes:GetChildren()[1].CFrame or CFrame.new(-932, 94, 2039)
    local hum = localp.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    local tries = 0
    while not hasGun(gunName) and autoGunsEnabled and tries < 100 do
        pcall(function()
            for _, item in ipairs(giver:GetChildren()) do
                if item.Name:find(gunName) then
                    event:InvokeServer(item)
                    break
                end
                local meshes = item:FindFirstChild("Meshes")
                if meshes then
                    for _, m in ipairs(meshes:GetChildren()) do
                        if m.Name:find(gunName) then
                            event:InvokeServer(m)
                            break
                        end
                    end
                end
            end
        end)
        task.wait(0.1)
        tries = tries + 1
    end
    if hum then
        for _, t in pairs(hum:GetPlayingAnimationTracks()) do t:Stop() end
    end
    hp.CFrame = og
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if autoGunsEnabled and localp.Team and localp.Team.Name ~= "Neutral" then
            for gunName, selected in pairs(autoGunsSelected) do
                if selected and not hasGun(gunName) then
                    pcall(giveGun, gunName)
                end
            end
        end
    end
end)

-- ========== AUTO ITEMS ==========
local autoItemsEnabled = false
local autoItemsList = {["Key card"] = true, ["Lunch"] = true, ["Breakfast"] = true, ["Dinner"] = true, ["Soda"] = true, ["Chips"] = true, ["Chocolate"] = true}

task.spawn(function()
    while true do
        task.wait(1)
        if autoItemsEnabled then
            local backpack = localp:FindFirstChildOfClass("Backpack")
            if backpack then
                local tools = ReplicatedStorage:FindFirstChild("Tools")
                if tools then
                    for itemName, selected in pairs(autoItemsList) do
                        if selected then
                            local item = tools:FindFirstChild(itemName)
                            if item and not backpack:FindFirstChild(itemName) then
                                pcall(function()
                                    item:Clone().Parent = backpack
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

