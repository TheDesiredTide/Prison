        Lighting.ClockTime = clockTime
    else
        Lighting.ClockTime = origLighting.ClockTime
    end
end)

-- ========== ANTI-TASE / ANTI-SIT / ANTI-FLING ==========
local antiTaseEnabled = false
local antiSitEnabled = false
local antiFlingEnabled = false

-- Anti-tase: hook PlayerTased remote to swallow
do
    local gunRemotes = ReplicatedStorage:WaitForChild("GunRemotes", 5)
    if gunRemotes then
        local playerTased = gunRemotes:FindFirstChild("PlayerTased")
        if playerTased then
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                if antiTaseEnabled and getnamecallmethod() == "FireServer" and self == playerTased then
                    return nil
                end
                return oldNamecall(self, ...)
            end)
        end
    end
end

-- Anti-sit: force unsit if not in vehicle
RunService.Stepped:Connect(function()
    if not antiSitEnabled then return end
    local ch = localp.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if hum and hum.Sit and hum.SeatPart and not hum.SeatPart:IsA("VehicleSeat") then
        hum.Sit = false
        hum.Jump = true
    end
end)

-- Anti-fling: anchor root when massive velocity detected
RunService.Heartbeat:Connect(function()
    if not antiFlingEnabled then return end
    local ch = localp.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local vel = root.AssemblyLinearVelocity
    if vel.Magnitude > 500 then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end)

-- ========== KILLFEED ==========
local killfeedGui = Instance.new("ScreenGui")
killfeedGui.Name = "MonarchKillfeed"
killfeedGui.IgnoreGuiInset = true
killfeedGui.ResetOnSpawn = false
killfeedGui.Parent = (function()
    local ok, r = pcall(gethui)
    if ok and r then return r end
    return CoreGui
end)()

local killfeedFrame = Instance.new("Frame")
killfeedFrame.Size = UDim2.new(0, 300, 0, 400)
killfeedFrame.Position = UDim2.new(1, -310, 0, 50)
killfeedFrame.BackgroundTransparency = 1
killfeedFrame.Parent = killfeedGui
local killfeedLayout = Instance.new("UIListLayout", killfeedFrame)
killfeedLayout.SortOrder = Enum.SortOrder.LayoutOrder
killfeedLayout.Padding = UDim.new(0, 4)
killfeedLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right

local function addKillfeedEntry(killerName, victimName, weaponName)
    local entry = Instance.new("Frame")
    entry.Size = UDim2.new(1, 0, 0, 26)
    entry.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    entry.BackgroundTransparency = 0.3
    entry.BorderSizePixel = 0
    entry.Parent = killfeedFrame
    Instance.new("UICorner", entry).CornerRadius = UDim.new(0, 4)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = killerName .. " [" .. (weaponName or "?") .. "] " .. victimName
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 11
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Parent = entry

    task.delay(5, function()
        if entry.Parent then
            entry:Destroy()
        end
    end)
end

-- Track deaths for killfeed
local killfeedEnabled = false
local playerHealths = {}
Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            playerHealths[plr] = hum.Health
            hum.HealthChanged:Connect(function(newHealth)
                if killfeedEnabled and newHealth <= 0 and playerHealths[plr] and playerHealths[plr] > 0 then
                    addKillfeedEntry("?", plr.Name, "?")
                end
                playerHealths[plr] = newHealth
            end)
        end
    end)
end)

-- ========== HIT SOUNDS ==========
local hitSoundEnabled = false
local hitSoundId = "rbxassetid://5043539486" -- Rust default
local hitSoundVolume = 0.5
local lastHitSound = 0

local function playHitSound()
    if not hitSoundEnabled then return end
    if tick() - lastHitSound < 0.05 then return end
    lastHitSound = tick()
    local snd = Instance.new("Sound")
    snd.SoundId = hitSoundId
    snd.Volume = hitSoundVolume
    snd.Parent = game:GetService("SoundService")
    snd:Play()
    task.delay(2, function() if snd then snd:Destroy() end end)
end

-- Hook meleeEvent to play hitsound on our hits
do
    local meleeEvent = ReplicatedStorage:FindFirstChild("meleeEvent")
    if meleeEvent then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" and self == meleeEvent then
                task.spawn(playHitSound)
            end
            return oldNamecall(self, ...)
        end)
    end
end

