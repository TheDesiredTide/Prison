-- ========== LOAD UWUWARE ==========
local Library
do
    local src = game:HttpGet('https://raw.githubusercontent.com/Stefanuk12/UI-Libraries/master/scripts/uwuware-2.x.lua')
    -- Patch: make every MouseButton1 / MouseMovement check also accept Touch
    src = src:gsub('UserInputType%.MouseButton1', '(UserInputType.MouseButton1 or UserInputType.Touch)')
    src = src:gsub('UserInputType%.MouseMovement', '(UserInputType.MouseMovement or UserInputType.Touch)')
    src = src:gsub('input%.UserInputType%.Name == "MouseButton1"', '((input.UserInputType.Name == "MouseButton1") or (input.UserInputType.Name == "Touch"))')
    src = src:gsub('input%.UserInputType%.Name == "MouseMovement"', '((input.UserInputType.Name == "MouseMovement") or (input.UserInputType.Name == "Touch"))')
    src = src:gsub('Input%.UserInputType%.Name == "MouseButton1"', '((Input.UserInputType.Name == "MouseButton1") or (Input.UserInputType.Name == "Touch"))')
    src = src:gsub('Input%.UserInputType%.Name == "MouseMovement"', '((Input.UserInputType.Name == "MouseMovement") or (Input.UserInputType.Name == "Touch"))')
    Library = loadstring(src)()
end

