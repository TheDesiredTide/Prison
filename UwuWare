local function arrest(arg)
    local player, err = findpl(arg)
    if not player then notify("Monarch Hub", err or "Player not found", 5) return end
    local ch = player.Character
    if not ch then notify("Monarch Hub", "Target Character Not Found", 5) return end
    local target = ch:FindFirstChild("HumanoidRootPart")
    if not target then notify("Monarch Hub", "Target Character Not Found", 5) return end
    local sh = ch:GetAttribute("Hostile")
    if not sh then notify("Monarch Hub", "Cant arrest, not hostile", 5) return end
    local ogt = localp.Team and localp.Team.Name or "Inmates"
    if localp.Team and localp.Team.Name ~= "Guards" then
        change("Guards")
        repeat task.wait(0.1) until localp:FindFirstChild("Backpack") and localp.Backpack:FindFirstChild("Handcuffs")
    end
    local event = storage.Remotes.ArrestPlayer
    local hp = gethp()
    local ch1 = getch()
    if not hp or not ch1 then notify("Monarch Hub", "Local character not found", 5) return end
    if ch:FindFirstChild("ForceField") then
        notify("Monarch Hub", "Waiting for ForceField", 5)
        repeat task.wait(0.1) until not ch:FindFirstChild("ForceField")
    end
    local og = hp.CFrame
    for _, v in pairs(ch1:GetChildren()) do
        if v:IsA("Tool") then v.Parent = localp.Backpack end
    end
    if not ch1:FindFirstChild("Handcuffs") then
        if not localp.Backpack:FindFirstChild("Handcuffs") then
            notify("Monarch Hub", "Must be in Guards team!", 5) return
        end
        localp.Backpack.Handcuffs.Parent = ch1
    end
    animh()
    for i = 1, 10 do
        pcall(function() event:InvokeServer(player, 1) end)
        if hp and hp.Parent and target and target.Parent then hp.CFrame = target.CFrame end
        task.wait()
    end
    local humanoid = gethm()
    if humanoid then
        for _, trac in pairs(humanoid:GetPlayingAnimationTracks()) do trac:Stop() end
    end
    change(ogt)
    repeat task.wait() until getch() and getch():FindFirstChild("HumanoidRootPart")
    local newHp = gethp()
    if newHp then newHp.CFrame = og end
end

-- ========== NOCLIP ==========
local noclipbool = false
local noclipConn = nil

local function setNoclipParts(char, canCollide)
    if not char then return end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = canCollide end
    end
end

local function noclip()
    pcall(function()
        local scriptsFolder = storage:FindFirstChild("Scripts")
        if scriptsFolder then
            local characterCollision = scriptsFolder:FindFirstChild("CharacterCollision")
            if characterCollision then characterCollision:Destroy() end
        end
    end)
    if noclipbool then return end
    noclipbool = true
    task.spawn(function()
        while noclipbool do
            local ch = getch()
            if ch then
                for _, v in pairs(ch:GetChildren()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
            task.wait()
        end
    end)
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = localp.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        if noclipbool then setNoclipParts(char, false) end
    end)
end

local function unnoclip()
    noclipbool = false
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    local ch = getch()
    if ch then
        if ch:FindFirstChild("Head") then ch.Head.CanCollide = true end
        if ch:FindFirstChild("Torso") then ch.Torso.CanCollide = true end
        if ch:FindFirstChild("UpperTorso") then ch.UpperTorso.CanCollide = true end
        if ch:FindFirstChild("LowerTorso") then ch.LowerTorso.CanCollide = true end
        if ch:FindFirstChild("HumanoidRootPart") then ch.HumanoidRootPart.CanCollide = true end
        setNoclipParts(ch, true)
    end
end

