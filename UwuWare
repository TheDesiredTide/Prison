--[[
    Prison Life Hub (MobileLinoriaLib Version)
    Supports mobile + PC. Loads MobileLinoriaLib and integrates all features.
]]

-- Load MobileLinoriaLib (mobile-compatible fork of Linoria)
local repo = 'https://raw.githubusercontent.com/thehogbro-byte/MobileLinoriaLib/main/'
local Library = loadstring(game:HttpGet(repo .. 'Library.lua'))()
local ThemeManager = loadstring(game:HttpGet(repo .. 'addons/ThemeManager.lua'))()
local SaveManager = loadstring(game:HttpGet(repo .. 'addons/SaveManager.lua'))()

local Window = Library:CreateWindow({
    Title = 'Prison Life Hub',
    Center = true,
    AutoShow = true,
    TabPadding = 8,
    MenuFadeTime = 0.2,
})

local Tabs = {
    Combat = Window:AddTab('Combat'),
    Movement = Window:AddTab('Movement'),
    Team = Window:AddTab('Team & Auto'),
    Misc = Window:AddTab('Misc'),
    ['UI Settings'] = Window:AddTab('UI Settings'),
}

-- ========== PASTE YOUR FUNCTION DEFINITIONS HERE ==========
-- Copy the function definitions from Kill.lua, Arrest.lua, Noclip.lua,
-- Crim.lua, AutoG.lua, Laser.lua, AutoRe.lua, Kick.lua, and SilentAim.lua.
-- For example:
-- getgenv().kill = kill
-- getgenv().arrest = arrest
-- getgenv().noclip = noclip / unnoclip
-- getgenv().crim = crim
-- getgenv().autog = autog / unautog
-- getgenv().laser = laser / unlaser
-- getgenv().autore = autore / unautore
-- getgenv().kick = kick / unkick
-- getgenv().silent = silent / unsilent
-- =========================================================

-- Combat Tab
local CombatGroup = Tabs.Combat:AddLeftGroupbox('Combat')

CombatGroup:AddToggle('SilentAim', {
    Text = 'Silent Aim',
    Default = false,
    Tooltip = 'Bullets redirect to closest target head',
}):OnChanged(function(state)
    if state then getgenv().silent() else getgenv().unsilent() end
end)

CombatGroup:AddToggle('Laser', {
    Text = 'Laser (Auto Fire/No Spread)',
    Default = false,
}):OnChanged(function(state)
    getgenv().laser(state)
end)

CombatGroup:AddButton('Kill Player', function()
    local name = Library:GetTextInput('Enter player name:', 'Kill')
    if name then getgenv().kill(name) end
end)

CombatGroup:AddButton('Arrest Player', function()
    local name = Library:GetTextInput('Enter player name:', 'Arrest')
    if name then getgenv().arrest(name) end
end)

-- Movement Tab
local MoveGroup = Tabs.Movement:AddLeftGroupbox('Movement')

MoveGroup:AddToggle('Noclip', {
    Text = 'Noclip',
    Default = false,
}):OnChanged(function(state)
    if state then getgenv().noclip() else getgenv().unnoclip() end
end)

-- Team & Auto Tab
local TeamGroup = Tabs.Team:AddLeftGroupbox('Team')

TeamGroup:AddButton('Become Criminal', function()
    getgenv().crim()
end)

TeamGroup:AddButton('Change Team', function()
    local team = Library:GetTextInput('Enter team (Inmates/Guards/Criminals):', 'Change Team')
    if team then getgenv().change(team) end
end)

TeamGroup:AddToggle('AutoGuns', {
    Text = 'Auto Guns (AK-47 + Remington)',
    Default = false,
}):OnChanged(function(state)
    if state then getgenv().autog() else getgenv().unautog() end
end)

TeamGroup:AddToggle('AutoRespawn', {
    Text = 'Auto Respawn',
    Default = false,
}):OnChanged(function(state)
    if state then getgenv().autore() else getgenv().unautore() end
end)

-- Misc Tab
local MiscGroup = Tabs.Misc:AddLeftGroupbox('Misc')

MiscGroup:AddButton('Car Kick Player', function()
    local name = Library:GetTextInput('Enter player name:', 'Car Kick')
    if name then getgenv().kick(name) end
end)

MiscGroup:AddButton('Stop Car Kick', function()
    getgenv().unkick()
end)

-- UI Settings (standard Linoria config)
local MenuGroup = Tabs['UI Settings']:AddLeftGroupbox('Menu')
MenuGroup:AddButton('Unload', function() Library:Unload() end)
MenuGroup:AddLabel('Menu bind'):AddKeyPicker('MenuKeybind', { Default = 'End', NoUI = true, Text = 'Menu keybind' })

Library.ToggleKeybind = Options.MenuKeybind

-- Addons
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)
SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({ 'MenuKeybind' })
ThemeManager:SetFolder('PrisonLifeHub')
SaveManager:SetFolder('PrisonLifeHub/prison-life')
SaveManager:BuildConfigSection(Tabs['UI Settings'])
ThemeManager:ApplyToTab(Tabs['UI Settings'])

print('[Prison Life Hub] Loaded with MobileLinoriaLib.')
