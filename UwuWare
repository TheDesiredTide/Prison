    if teamn == "Inmates" then
        repeat
            local Event = storage.Remotes.RequestTeamChange
            Event:InvokeServer(team.Neutral, 1)
            Event:InvokeServer(team.Inmates, 1)
            if localp.PlayerGui.Home.IntroFrame.ContentBackground.MainMenuFrame.TeamsFrame.Inmates.Button.TextLabel.Text ~= "Join" then
                notify("Monarch Hub", "Team full cant do", 5) break
            end
        until localp.Team and localp.Team.Name == "Inmates"
    elseif teamn == "Guards" then
        repeat
            local Event = storage.Remotes.RequestTeamChange
            Event:InvokeServer(team.Neutral, 1)
            Event:InvokeServer(team.Guards, 1)
            if localp.PlayerGui.Home.IntroFrame.ContentBackground.MainMenuFrame.TeamsFrame.Guards.Button.TextLabel.Text ~= "Join" then
                notify("Monarch Hub", "Team full cant do", 5) break
            end
        until localp.Team and localp.Team.Name == "Guards"
    elseif teamn == "Criminals" then
        repeat
            local Event = storage.Remotes.RequestTeamChange
            Event:InvokeServer(team.Neutral, 1)
            Event:InvokeServer(team.Inmates, 1)
            if localp.PlayerGui.Home.IntroFrame.ContentBackground.MainMenuFrame.TeamsFrame.Inmates.Button.TextLabel.Text ~= "Join" then
                notify("Monarch Hub", "Team full cant do", 5) break
            end
        until localp.Team and localp.Team.Name == "Inmates"
        task.wait(0.1)
        crim2()
        repeat task.wait() until not (getch() and getch():FindFirstChild("ForceField"))
    end
end

-- ========== KILL (with invisible) ==========
local invisiblebool, invisibleconn, invisiblebind, invisanimtrack, invisoldcf = false, nil, nil, nil, nil

local function animationTrickery()
    local ch = getch() local hm = gethm()
    if not ch or not hm then return end
    local isR15 = hm.RigType == Enum.HumanoidRigType.R15
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. (isR15 and "18665825805" or "215384594")
    local animator = hm:FindFirstChildOfClass("Animator") or hm:WaitForChild("Animator", 3)
    if not animator then return end
    if invisanimtrack then pcall(function() invisanimtrack:Stop() invisanimtrack:Destroy() end) invisanimtrack = nil end
    invisanimtrack = animator:LoadAnimation(anim)
    invisanimtrack.Priority = Enum.AnimationPriority.Action4
    invisanimtrack:Play(0, 0.001, 0)
    anim:Destroy()
    task.delay(0.05, function()
        if invisanimtrack and invisanimtrack.IsPlaying then
            invisanimtrack.TimePosition = isR15 and 1.95 or 0.4
            invisanimtrack:AdjustSpeed(0)
        end
    end)
end

local function invisible()
    if invisiblebool then return end
    invisiblebool = true invisoldcf = nil
    animationTrickery()
    local bindKey = "Invis_" .. tostring(tick())
    invisiblebind = bindKey
    pcall(function()
        RunService:BindToRenderStep(bindKey, Enum.RenderPriority.Camera.Value - 1, function()
            if not invisiblebool then return end
            local ch = localp.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            if root and invisoldcf then
                root.CFrame = invisoldcf
                if invisanimtrack then pcall(function() invisanimtrack:AdjustWeight(0.001) end) end
            end
        end)
    end)
    if invisibleconn then invisibleconn:Disconnect() invisibleconn = nil end
    invisibleconn = RunService.Heartbeat:Connect(function()
        if not invisiblebool then return end
        local ch = localp.Character if not ch then return end
        local hm = ch:FindFirstChildOfClass("Humanoid")
        local root = ch:FindFirstChild("HumanoidRootPart")
        if not (hm and root) then return end
        if not invisanimtrack or not invisanimtrack.IsPlaying then animationTrickery() end
        local isR15 = hm.RigType == Enum.HumanoidRigType.R15
        local offset = Vector3.new(0, hm.HipHeight + (root.Size.Y / 2) - 1, 0)
        invisoldcf = root.CFrame
        root.CFrame = (root.CFrame - offset) * CFrame.Angles(math.rad(isR15 and 180 or 90), 0, 0)
        if invisanimtrack then
            pcall(function() invisanimtrack:AdjustWeight(100) invisanimtrack:AdjustSpeed(0) end)
        end
    end)
    notify("Monarch Hub", "Invisible Enabled", 3)
end

local function uninvisible()
    if not invisiblebool then return end
    invisiblebool = false
    if invisibleconn then invisibleconn:Disconnect() invisibleconn = nil end
    if invisiblebind then pcall(function() RunService:UnbindFromRenderStep(invisiblebind) end) invisiblebind = nil end
    if invisanimtrack then pcall(function() invisanimtrack:Stop() invisanimtrack:Destroy() end) invisanimtrack = nil end
    local ch = localp.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    if root and invisoldcf then root.CFrame = invisoldcf end
    invisoldcf = nil
    notify("Monarch Hub", "Invisible Disabled", 3)
end

local function kill(arg)
    local player, err = findpl(arg)
    if not player then notify("Monarch Hub", err, 5) return end
    local ogt = localp.Team.Name
    local ch = player.Character
    if not ch then notify("Monarch Hub", "Target Character Not Found", 5) return end
    local target = ch:FindFirstChild("HumanoidRootPart")
    if not target then notify("Monarch Hub", "Target Character Not Found", 5) return end
    if ch:FindFirstChild("ForceField") then
        notify("Monarch Hub", "Waiting for ForceField", 5)
        repeat task.wait(0.1) until not ch:FindFirstChild("ForceField")
    end
    if player.Team and player.Team.Name == "Guards" and localp.Team and localp.Team.Name == "Guards" then change("Inmates") end
    local ch1 = getch()
    if localp.Team and localp.Team.Name == "Criminals" and ch1 and ch1:FindFirstChild("ForceField") then
        notify("Monarch Hub", "Waiting for ForceField", 5)
        repeat task.wait(0.1) until not ch1:FindFirstChild("ForceField")
    end
    local hp = gethp() local hm = gethm() local og = hp.CFrame
    invisible()
    local Event = storage.meleeEvent
    repeat
        if hm.Health == 0 then cam.CameraSubject = gethm() break end
        cam.CameraSubject = ch.Humanoid
        Event:FireServer(player, 1, 1)
        hp.CFrame = target.CFrame * CFrame.new(0, -2.5, 0)
        hm:ChangeState(3)
        task.wait()
    until ch.Humanoid.Health == 0
    for _, trac in pairs(gethm():GetPlayingAnimationTracks()) do trac:Stop() end
    uninvisible()
    if ogt == "Guards" then change(ogt) end
    hp.CFrame = og
    cam.CameraSubject = gethm()
end

-- ========== ARREST ==========
local function animh()
    local hum = gethm() if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2)
    if not animator then return end
    local anim = Instance.new("Animation") anim.AnimationId = "rbxassetid://215384594"
    local anim1 = Instance.new("Animation") anim1.AnimationId = "rbxassetid://279229192"
    local track = animator:LoadAnimation(anim) track:Play() track.TimePosition = 2 track:AdjustSpeed(0)
    local track1 = animator:LoadAnimation(anim1) track1:Play() track1.TimePosition = 2 track1:AdjustSpeed(0)
end

local function arrest(arg)
    local player, err = findpl(arg)
    if not player then notify("Monarch Hub", err or "Player not found", 5) return end
    local ch = player.Character
    if not ch then notify("Monarch Hub", "Target Character Not Found", 5) return end
    local target = ch:FindFirstChild("HumanoidRootPart")
    if not target then notify("Monarch Hub", "Target Character Not Found", 5) return end
    if not ch:GetAttribute("Hostile") then notify("Monarch Hub", "Cant arrest, not hostile", 5) return end
    local ogt = localp.Team and localp.Team.Name or "Inmates"
    if localp.Team and localp.Team.Name ~= "Guards" then
        change("Guards")
        repeat task.wait(0.1) until localp:FindFirstChild("Backpack") and localp.Backpack:FindFirstChild("Handcuffs")
    end
    local event = storage.Remotes.ArrestPlayer
    local hp = gethp() local ch1 = getch()
    if not hp or not ch1 then notify("Monarch Hub", "Local character not found", 5) return end
    if ch:FindFirstChild("ForceField") then
        notify("Monarch Hub", "Waiting for ForceField", 5)
        repeat task.wait(0.1) until not ch:FindFirstChild("ForceField")
    end
    local og = hp.CFrame
    for _, v in pairs(ch1:GetChildren()) do if v:IsA("Tool") then v.Parent = localp.Backpack end end
    if not ch1:FindFirstChild("Handcuffs") then
        if not localp.Backpack:FindFirstChild("Handcuffs") then notify("Monarch Hub", "Must be in Guards team!", 5) return end
        localp.Backpack.Handcuffs.Parent = ch1
    end
    animh()
    for i = 1, 10 do
        pcall(function() event:InvokeServer(player, 1) end)
        if hp and hp.Parent and target and target.Parent then hp.CFrame = target.CFrame end
        task.wait()
    end
    local humanoid = gethm()
    if humanoid then for _, trac in pairs(humanoid:GetPlayingAnimationTracks()) do trac:Stop() end end
    change(ogt)
    repeat task.wait() until getch() and getch():FindFirstChild("HumanoidRootPart")
    local newHp = gethp()
    if newHp then newHp.CFrame = og end
end

-- ========== NOCLIP ==========
local noclipbool = false
local noclipConn = nil
local function setNoclipParts(char, canCollide)
    if not char then return end
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = canCollide end
    end
end
local function noclip()
    pcall(function()
        local sf = storage:FindFirstChild("Scripts")
        if sf then local cc = sf:FindFirstChild("CharacterCollision") if cc then cc:Destroy() end end
    end)
    if noclipbool then return end
    noclipbool = true
    task.spawn(function()
        while noclipbool do
            local ch = getch()
            if ch then
                for _, v in pairs(ch:GetChildren()) do if v:IsA("BasePart") then v.CanCollide = false end end
            end
            task.wait()
        end
    end)
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = localp.CharacterAdded:Connect(function(char)
        task.wait(0.1) if noclipbool then setNoclipParts(char, false) end
    end)
end
local function unnoclip()
    noclipbool = false
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    local ch = getch()
    if ch then
        if ch:FindFirstChild("Head") then ch.Head.CanCollide = true end
        if ch:FindFirstChild("Torso") then ch.Torso.CanCollide = true end
        if ch:FindFirstChild("UpperTorso") then ch.UpperTorso.CanCollide = true end
        if ch:FindFirstChild("LowerTorso") then ch.LowerTorso.CanCollide = true end
        if ch:FindFirstChild("HumanoidRootPart") then ch.HumanoidRootPart.CanCollide = true end
        setNoclipParts(ch, true)
    end
end

