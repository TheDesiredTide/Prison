-- Detect device and load the corresponding Obsidian source
local repo
if game:GetService("UserInputService").TouchEnabled then
    repo = 'https://raw.githubusercontent.com/deividcomsono/Obsidian/main/'
    print("[Monarch Hub] Mobile mode loaded")
else
    repo = 'https://raw.githubusercontent.com/deividcomsono/Obsidian/main/'
    print("[Monarch Hub] PC mode loaded")
end

local Library = loadstring(game:HttpGet(repo .. 'Library.lua'))()
local ThemeManager = loadstring(game:HttpGet(repo .. 'addons/ThemeManager.lua'))()
local SaveManager = loadstring(game:HttpGet(repo .. 'addons/SaveManager.lua'))()

-- Create window
local Window = Library:CreateWindow({
    Title = 'Monarch Hub',
    Center = true,
    AutoShow = true,
    TabPadding = 8,
    MenuFadeTime = 0.2,
})

local Tabs = {
    Combat = Window:AddTab('Combat', 'crosshair'),
    Movement = Window:AddTab('Movement', 'run'),
    Team = Window:AddTab('Team & Auto', 'users'),
    Misc = Window:AddTab('Misc', 'wrench'),
    ['UI Settings'] = Window:AddTab('UI Settings', 'settings'),
}

-- ========== PASTE YOUR FUNCTION DEFINITIONS HERE ==========
-- Copy kill, arrest, noclip, crim, autog, laser, autore, kick, silent, etc.
-- ==========================================================

-- Combat Tab example
local CombatGroup = Tabs.Combat:AddLeftGroupbox('Combat')

CombatGroup:AddToggle('SilentAim', {
    Text = 'Silent Aim',
    Default = false,
    Tooltip = 'Bullets redirect to target head',
    Callback = function(state)
        if state then silent() else unsilent() end
    end,
})

CombatGroup:AddToggle('Laser', {
    Text = 'Laser (Auto/No Spread)',
    Default = false,
    Callback = function(state) laser(state) end,
})

CombatGroup:AddInput('KillTarget', {
    Text = 'Target name',
    Default = '',
    Placeholder = 'Enter player name',
})

CombatGroup:AddButton({
    Text = 'Kill Player',
    Func = function()
        local name = Options.KillTarget.Value
        if name and name ~= '' then kill(name) end
    end,
})

-- Movement Tab
local MoveGroup = Tabs.Movement:AddLeftGroupbox('Movement')
MoveGroup:AddToggle('Noclip', { Text = 'Noclip', Default = false, Callback = function(s) if s then noclip() else unnoclip() end end })

-- Team Tab
local TeamGroup = Tabs.Team:AddLeftGroupbox('Team')
TeamGroup:AddButton({ Text = 'Become Criminal', Func = function() crim() end })
TeamGroup:AddToggle('AutoGuns', { Text = 'Auto Guns', Default = false, Callback = function(s) if s then autog() else unautog() end end })
TeamGroup:AddToggle('AutoRespawn', { Text = 'Auto Respawn', Default = false, Callback = function(s) if s then autore() else unautore() end end })

-- Misc Tab
local MiscGroup = Tabs.Misc:AddLeftGroupbox('Misc')
MiscGroup:AddInput('KickTarget', { Text = 'Target name', Default = '', Placeholder = 'Enter player name' })
MiscGroup:AddButton({ Text = 'Car Kick', Func = function()
    local name = Options.KickTarget.Value
    if name and name ~= '' then kick(name) end
end })
MiscGroup:AddButton({ Text = 'Stop Kick', Func = function() unkick() end })

-- UI Settings
local MenuGroup = Tabs['UI Settings']:AddLeftGroupbox('Menu')
MenuGroup:AddButton({ Text = 'Unload', Func = function() Library:Unload() end })
MenuGroup:AddLabel('Menu bind'):AddKeyPicker('MenuKeybind', { Default = 'End', NoUI = true, Text = 'Menu keybind' })
Library.ToggleKeybind = Options.MenuKeybind

-- Addons
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)
SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({'MenuKeybind'})
ThemeManager:SetFolder('MonarchHub')
SaveManager:SetFolder('MonarchHub/prison-life')
SaveManager:BuildConfigSection(Tabs['UI Settings'])
ThemeManager:ApplyToTab(Tabs['UI Settings'])

print('[Monarch Hub] Loaded with Obsidian UI.')
