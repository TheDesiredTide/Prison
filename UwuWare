XG.BackgroundTransparency = 1
XG.Parent = MiscTab.page
XG.AutomaticSize = Enum.AutomaticSize.Y
local xgl = Instance.new("UIListLayout", XG)
xgl.SortOrder = Enum.SortOrder.LayoutOrder
xgl.Padding = UDim.new(0, 4)
addLabel(XG, "CAR KICK")
createButton("Car Kick Player", function()
    showPrompt("Car Kick - Enter Name:", "Player name...", function(n) kick(n) end)
end, XG)
createButton("Stop Car Kick", function() unkick() end, XG)
addLabel(XG, "UNLOAD")
createButton("Unload Script", function()
    screenGui:Destroy()
    promptGui:Destroy()
    getgenv().kill = nil
    getgenv().arrest = nil
    getgenv().noclip = nil
    getgenv().crim = nil
    getgenv().autog = nil
    getgenv().laser = nil
    getgenv().autore = nil
    getgenv().kick = nil
    getgenv().silent = nil
    print("[Monarch Hub] Unloaded.")
end, XG)

-- Toggle menu
local function toggleMenu()
    menuOpen = not menuOpen
    mainFrame.Visible = menuOpen
end
toggleBtn.MouseButton1Click:Connect(toggleMenu)
toggleBtn.Activated:Connect(function() toggleMenu() end)
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then toggleMenu() end
end)

if isMobile then
    toggleBtn.Visible = true
    mainFrame.Visible = false
else
    toggleBtn.Visible = true
    mainFrame.Visible = true
    menuOpen = true
end

